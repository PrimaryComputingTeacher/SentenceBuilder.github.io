            document.getElementById('view-teacher-admin').classList.add('hidden');
            
            document.getElementById('tab-pupil').classList.remove('active', 'border-gray-600');
            document.getElementById('tab-teacher').classList.remove('active', 'border-gray-600');
            
            if (viewId === 'pupil') {
                document.getElementById('view-pupil').classList.remove('hidden');
                document.getElementById('tab-pupil').classList.add('active', 'border-gray-600');
                renderPupilDashboard();
            } else if (viewId === 'teacher-login') {
                document.getElementById('view-teacher-login').classList.remove('hidden');
                document.getElementById('tab-teacher').classList.add('active', 'border-gray-600');
                document.getElementById('admin-password').value = '';
                document.getElementById('login-error').classList.add('hidden');
            } else if (viewId === 'teacher-admin') {
                document.getElementById('view-teacher-admin').classList.remove('hidden');
                document.getElementById('tab-teacher').classList.add('active', 'border-gray-600');
                renderTeacherDashboard();
            }
        }

        function checkPassword() {
            const pass = document.getElementById('admin-password').value;
            if (pass === 'teacher2026') {
                switchView('teacher-admin');
            } else {
                document.getElementById('login-error').classList.remove('hidden');
            }
        }

        function selectWord(cat, word) {
            if (currentSentence[cat] === word) {
                currentSentence[cat] = null; // Toggle off
            } else {
                currentSentence[cat] = word; // Toggle on
            }
            renderPupilDashboard();
        }

        function clearSentence() {
            Object.keys(currentSentence).forEach(k => currentSentence[k] = null);
            renderPupilDashboard();
        }

        function updateSentenceDisplay() {
            const outputArea = document.getElementById('sentence-output');
            outputArea.innerHTML = '';
            
            let hasWords = false;
            
            order.forEach(cat => {
                if (wordBanks[cat] && wordBanks[cat].length > 0) {
                    const conf = config[cat];
                    const wordData = currentSentence[cat];
                    
                    const span = document.createElement('span');
                    if (wordData) {
                        hasWords = true;
                        // Seamless baseline alignment preserving Exact Teacher Casing
                        span.className = `inline-block align-baseline px-1.5 py-0.5 mx-0.5 rounded ${conf.bgMinimal} transition-all duration-300`;
                        span.textContent = cleanWord(wordData);
                    } else {
                        // Translucent Placeholder
                        span.className = `inline-block align-baseline px-2 py-0.5 mx-0.5 rounded text-[0.8em] tracking-wide ${conf.placeholderMinimal} opacity-70`;
                        span.textContent = `[ ${conf.title} ]`;
                    }
                    outputArea.appendChild(span);
                    outputArea.appendChild(document.createTextNode(' '));
                }
            });

            if (hasWords) {
                const dot = document.createElement('span');
                dot.className = 'inline-block align-baseline font-bold text-slate-800 ml-0.5';
                dot.textContent = '.';
                outputArea.appendChild(dot);
            }
        }

        function renderPupilDashboard() {
            const container = document.getElementById('word-columns-container');
            container.innerHTML = '';
            
            let activeColumnsCount = 0;
            
            order.forEach(cat => {
                if (wordBanks[cat] && wordBanks[cat].length > 0) {
                    activeColumnsCount++;
                    const conf = config[cat];
                    const col = document.createElement('div');
                    col.className = `flex flex-col gap-2 p-3 rounded-xl border-2 bg-white shadow-sm ${conf.columnBorder}`;
                    
                    const header = document.createElement('div');
                    header.className = `flex flex-col items-center justify-center p-3 rounded-lg mb-2 text-center ${conf.headerBg} shadow-sm`;
                    header.innerHTML = `
                        ${conf.symbolSvg}
                        <span class="font-bold text-sm tracking-wide mt-1">${conf.title}</span>
                        <span class="text-[10px] opacity-90 uppercase tracking-wider">${conf.subtitle}</span>
                    `;
                    col.appendChild(header);

                    wordBanks[cat].forEach(word => {
                        const btn = document.createElement('button');
                        const isSelected = currentSentence[cat] === word;
                        btn.className = `word-btn px-3 py-3 rounded-lg border-2 text-left font-medium w-full ${isSelected ? 'active ring-2 ring-offset-1 ring-slate-300 ' + conf.bgMinimal : conf.btnStyle}`;
                        
                        const emoji = getEmojiForWord(word) || conf.defaultIcon;
                        const cleanTxt = cleanWord(word);
                        
                        btn.innerHTML = `<span class="text-xl shrink-0">${emoji}</span> <span class="leading-tight">${cleanTxt}</span>`;
                        btn.onclick = () => selectWord(cat, word);
                        
                        col.appendChild(btn);
                    });
                    container.appendChild(col);
                }
            });
            
            // Auto grid layout based on number of active columns
            container.className = `dynamic-grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-${Math.min(activeColumnsCount, 4)} xl:grid-cols-${Math.min(activeColumnsCount, 5)}`;
            
            updateSentenceDisplay();
        }

        function syncAdminTextareasToState() {
            order.forEach(cat => {
                const textarea = document.getElementById(`admin-words-${cat}`);
                if (textarea) {
                    const lines = textarea.value.split('\n').map(l => l.trim()).filter(l => l !== '');
                    wordBanks[cat] = lines.slice(0, 6);
                }
            });
        }

        function moveCategory(index, direction) {
            syncAdminTextareasToState(); // Save typed changes before re-rendering grid
            const newIndex = index + direction;
            if (newIndex < 0 || newIndex >= order.length) return;
            
            const temp = order[index];
            order[index] = order[newIndex];
            order[newIndex] = temp;
            
            renderTeacherDashboard();
        }

        function renderTeacherDashboard() {
            const grid = document.getElementById('admin-editors-grid');
            const preview = document.getElementById('admin-sequence-preview');
            grid.innerHTML = '';
            preview.innerHTML = '';

            order.forEach((cat, index) => {
                const conf = config[cat];
                
                // Top Sequence Preview
                const badge = document.createElement('div');
                badge.className = `px-3 py-1.5 rounded-lg flex items-center gap-1 ${conf.headerBg} shadow-sm`;
                badge.innerHTML = `<span>${index + 1}.</span> <span>${conf.title}</span>`;
                preview.appendChild(badge);
                
                if (index < order.length - 1) {
                    const arrow = document.createElement('span');
                    arrow.className = 'text-gray-400 font-bold';
                    arrow.textContent = '➔';
                    preview.appendChild(arrow);
                }

                // Grid Editor
                const box = document.createElement('div');
                box.className = `p-4 rounded-xl border-2 bg-white shadow-sm flex flex-col h-full ${conf.columnBorder}`;
                
                const header = document.createElement('div');
                header.className = 'flex justify-between items-center mb-3';
                header.innerHTML = `
                    <h4 class="font-bold flex items-center gap-2 text-gray-800">
                        <span class="${conf.headerBg} w-6 h-6 rounded-full flex items-center justify-center text-xs shadow-sm">${index + 1}</span>
                        ${conf.title}
                    </h4>
                    <div class="flex gap-1">
                        <button onclick="moveCategory(${index}, -1)" class="p-1.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors" title="Move Left" ${index === 0 ? 'disabled class="opacity-30"' : ''}>◀</button>
                        <button onclick="moveCategory(${index}, 1)" class="p-1.5 rounded bg-gray-100 hover:bg-gray-200 text-gray-600 transition-colors" title="Move Right" ${index === order.length - 1 ? 'disabled class="opacity-30"' : ''}>▶</button>
                    </div>
                `;
                
                const textarea = document.createElement('textarea');
                textarea.id = `admin-words-${cat}`;
                textarea.className = 'w-full flex-grow p-3 border border-gray-300 rounded-lg text-sm resize-none focus:ring-2 focus:ring-slate-500 focus:outline-none';
                textarea.rows = 6;
                textarea.placeholder = "Enter words here...\nOne per line\nMax 6 words\nLeave empty to hide";
                textarea.value = wordBanks[cat] ? wordBanks[cat].join('\n') : '';
                
                // Auto-save typing so it is not lost when changing order
                textarea.oninput = syncAdminTextareasToState; 

                box.appendChild(header);
                box.appendChild(textarea);
                grid.appendChild(box);
            });
        }

        function saveAndCloseAdmin() {
            syncAdminTextareasToState();
            clearSentence();
            switchView('pupil');
            showToast('💾 Settings Saved & Locked');
        }

        function copyToClipboard(text, successMsg) {
            const dummy = document.createElement('textarea');
            document.body.appendChild(dummy);
            dummy.value = text;
            dummy.select();
            document.execCommand('copy');
            document.body.removeChild(dummy);
            showToast(successMsg);
        }

        function generateShareableLink() {
            syncAdminTextareasToState();
            const state = { o: order, w: wordBanks };
            const encoded = btoa(encodeURIComponent(JSON.stringify(state)));
            const hashString = `#data=${encoded}`;
            
            const urlObj = new URL(window.location.href);
            urlObj.hash = hashString;
            const finalUrl = urlObj.toString();

            copyToClipboard(finalUrl, '📋 Pupil Link copied to clipboard!');
        }

        function resetToDefaultWords() {
            if(confirm("Are you sure you want to load default words? This will erase your current lists.")) {
                order = [...DEFAULT_ORDER];
                wordBanks = JSON.parse(JSON.stringify(DEFAULT_WORD_BANKS));
                renderTeacherDashboard();
                showToast('🔄 Default words loaded');
            }
        }

        function hydrateFromURL() {
            const hash = window.location.hash;
            if (hash && hash.includes('#data=')) {
                try {
                    const encoded = hash.split('#data=')[1];
                    const decoded = JSON.parse(decodeURIComponent(atob(encoded)));
                    if (decoded.o && decoded.w) {
                        order = decoded.o;
                        wordBanks = decoded.w;
                        showToast('🌟 Custom word list loaded!');
                        return true;
                    }
                } catch (e) {
                    console.error("Failed to load state from URL", e);
                    showToast('⚠️ Link broken. Loaded defaults.');
                }
            }
            return false;
        }

        function showToast(msg) {
            const toast = document.getElementById('toast-notification');
            const msgEl = document.getElementById('toast-message');
            msgEl.textContent = msg;
            toast.classList.remove('translate-y-20', 'opacity-0');
            setTimeout(() => {
                toast.classList.add('translate-y-20', 'opacity-0');
            }, 3000);
        }

        function readSentence() {
            if (!('speechSynthesis' in window)) {
                document.getElementById('tts-error').classList.remove('hidden');
                return;
            }
            
            let parts = [];
            order.forEach(cat => {
                if (currentSentence[cat]) {
                    parts.push(cleanWord(currentSentence[cat]));
                }
            });
            
            const text = parts.join(' ');
            if (text.length > 0) {
                const utterance = new SpeechSynthesisUtterance(text);
                utterance.lang = 'en-GB';
                utterance.rate = 0.9;
                window.speechSynthesis.speak(utterance);
            }
        }

        // Initialize App
        window.onload = () => {
            hydrateFromURL();
            switchView('pupil');
        };
    </script>
</body>
</html>
